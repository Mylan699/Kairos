{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [ { "Name": "Console" } ]
  },
  "AllowedHosts": "*",
  "RateLimiting": {
    "ReadPermitsPerMinute": 600,
    "WritePermitsPerMinute": 60
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Replay": {
    "TickMilliseconds": 500,
    "DefaultDate": "2020-03-16",
    "DefaultSpeed": 120,
    "DefaultStartMinute": 780,
    "IdleResetMinutes": 20,
    "NightlyResetHourUtc": 3
  }
}
